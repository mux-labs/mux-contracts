# =============================================================================
# Mux Protocol — Local Soroban Node Configuration
# =============================================================================
# Copy this file:  cp .env.localnet.example .env.localnet
# Then start the node:
#   docker-compose --env-file .env.localnet up --wait
#
# Variables that have sensible defaults are shown with those defaults.
# Variables without defaults MUST be filled in after contract deployment.
# Never commit .env.localnet — it is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Image
# -----------------------------------------------------------------------------
# Pin to soroban-latest for local dev, or to a digest for reproducible builds.
# To pin:  docker inspect --format '{{index .RepoDigests 0}}' stellar/quickstart:soroban-latest
# Example: stellar/quickstart@sha256:<digest>
QUICKSTART_IMAGE_TAG=soroban-latest

# Soroban protocol version to activate on the standalone chain.
# Set to 21 (or the current mainnet protocol version) to match production.
PROTOCOL_VERSION=21

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------
# standalone — private chain, fast ledger closes (~1 s), built-in Friendbot
# testnet    — connect to the public Stellar testnet (no Friendbot override)
NETWORK=standalone

# Network passphrase used by the standalone chain.
# The Stellar CLI and SDK clients need this to sign and validate transactions.
LOCALNET_NETWORK_PASSPHRASE=Standalone Network ; February 2025

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
# Soroban RPC + Horizon via the nginx reverse proxy inside the container.
SOROBAN_RPC_PORT=8000

# Direct Horizon port (useful for --horizon-url in Stellar CLI commands).
HORIZON_PORT=8001

# -----------------------------------------------------------------------------
# RPC endpoint (used by integration tests and SDK clients)
# -----------------------------------------------------------------------------
LOCALNET_RPC_URL=http://localhost:8000

# Which network the TypeScript tests and examples default to.
SOROBAN_NETWORK=localnet

# -----------------------------------------------------------------------------
# Resource limits for the quickstart container
# -----------------------------------------------------------------------------
# Adjust these if your machine has fewer resources. The container will be
# killed if it exceeds the memory limit, so leave at least 512 MB headroom.
QUICKSTART_CPUS=2.0
QUICKSTART_MEMORY=2G

# -----------------------------------------------------------------------------
# Volume / storage
# -----------------------------------------------------------------------------
# Driver for the soroban-data volume.
#   local  — standard bind-mount (default, persists between restarts)
#   tmpfs  — in-memory only, lost on container stop (good for ephemeral CI)
SOROBAN_DATA_DRIVER=local

# Size cap for the soroban-data volume (advisory; enforced by some drivers).
SOROBAN_DATA_SIZE=2g

# Host path for the soroban-data volume when using the local driver.
# Leave blank to use Docker's default managed volume path.
SOROBAN_DATA_DEVICE=

# -----------------------------------------------------------------------------
# Contract addresses on localnet
# Populate these after deploying with:
#   cargo build --target wasm32-unknown-unknown --release --workspace
#   stellar contract deploy --wasm target/wasm32-unknown-unknown/release/<name>.wasm \
#       --source <DEPLOYER_SECRET> --network localnet
# Then write each returned contract ID below and re-source this file.
# See also config/addresses.json for per-network address storage used by the
# TypeScript SDK (bindings/src/network.ts).
# -----------------------------------------------------------------------------

# Core contracts
LOCALNET_MUX_ACCOUNT_ID=
LOCALNET_MUX_BATCHER_ID=
LOCALNET_MUX_PERMISSIONS_ID=
LOCALNET_MUX_SPENDING_POLICY_ID=
LOCALNET_MUX_ACCOUNT_FACTORY_ID=

# Registry & wallet contracts
LOCALNET_MUX_REGISTRY_ID=
LOCALNET_MUX_WALLET_REGISTRY_ID=

# Delegation & recovery contracts
LOCALNET_MUX_DELEGATION_ID=
LOCALNET_MUX_RECOVERY_ID=
LOCALNET_MUX_POLICY_ID=

# -----------------------------------------------------------------------------
# TTL / storage keeper (optional — for long-running local nodes)
# -----------------------------------------------------------------------------
# The Mux contracts auto-extend their instance storage TTL on every write
# (TTL_THRESHOLD=17280 ledgers ≈ 1 day; TTL_EXTEND_TO=518400 ≈ 30 days).
# If a contract is idle for >30 days the entry expires and all state is lost.
# Run the keeper command below at least once every 25 days:
#
#   stellar contract extend \
#     --id $LOCALNET_MUX_ACCOUNT_ID \
#     --ledgers-to-extend 518400 \
#     --source <KEEPER_SECRET> \
#     --network localnet
#
# Repeat for each contract ID above. See docs/storage-griefing.md for the
# full per-contract runbook and collection-cap reference.

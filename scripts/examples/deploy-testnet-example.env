# ==============================================================================
# scripts/examples/deploy-testnet-example.env
#
# EXAMPLE environment file for deploying Mux Protocol contracts to Stellar Testnet.
#
# HOW TO USE
# ----------
#   1. Copy this file:
#        cp scripts/examples/deploy-testnet-example.env .env.testnet
#
#   2. Replace every placeholder value (indicated by angle brackets or EXAMPLE)
#      with your real values.
#
#   3. Source the file before running a deploy script:
#        source .env.testnet
#        bash scripts/deploy-testnet.sh
#
# IMPORTANT
# ---------
#   - NEVER commit a file that contains real secret keys.
#   - .env.testnet, .env.mainnet, and .env.deploy are all listed in .gitignore.
#   - Only this example file (with placeholder values) lives in version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Network configuration
# ------------------------------------------------------------------------------

# Which Stellar network to target.
# Accepted values: testnet | mainnet | localnet | futurenet
MUX_NETWORK=testnet

# Soroban RPC endpoint for the target network.
# Testnet public endpoint (no auth required):
MUX_RPC_URL=https://soroban-testnet.stellar.org
# Mainnet example (replace with your provider's URL if using a private RPC):
# MUX_RPC_URL=https://soroban-mainnet.stellar.org

# Network passphrase — uniquely identifies the Stellar network.
# Must exactly match the passphrase used by the RPC node.
# Testnet passphrase:
MUX_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Mainnet passphrase:
# MUX_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# Localnet passphrase:
# MUX_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# Horizon REST API endpoint (used by fund-accounts.sh and balance checks).
MUX_HORIZON_URL=https://horizon-testnet.stellar.org
# Mainnet: MUX_HORIZON_URL=https://horizon.stellar.org

# ------------------------------------------------------------------------------
# Deployer keypair
# ------------------------------------------------------------------------------

# Secret key (S...) for the account that will sign and pay for deploy transactions.
# This account must exist on the target network and hold enough XLM to cover fees.
# Minimum recommended balance: 10 XLM for testnet, 20 XLM for mainnet.
#
# To generate a fresh keypair:
#   stellar keys generate --global deployer --network testnet
#   stellar keys address deployer        # prints the public key
#   stellar keys show deployer           # prints the secret key
#
# To fund on testnet with Friendbot:
#   bash scripts/fund-accounts.sh
MUX_DEPLOYER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Public key (G...) corresponding to MUX_DEPLOYER_SECRET.
# Used for balance checks and display purposes — not a secret.
MUX_DEPLOYER_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# Contract administration
# ------------------------------------------------------------------------------

# Stellar address (G...) that will be set as the initial admin for each deployed
# contract. This is the account authorised to call privileged contract functions
# (upgrade, admin transfers, pause, etc.).
#
# For testnet: this can be the same as MUX_DEPLOYER_ADDRESS.
# For mainnet: this MUST be a multisig address or governance contract — never a
#              single EOA.
MUX_ADMIN_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# Friendbot (testnet / localnet only)
# ------------------------------------------------------------------------------

# URL for the Friendbot service that funds accounts with testnet XLM.
# Leave blank or unset for mainnet — Friendbot does not exist on mainnet.
FRIENDBOT_URL=https://friendbot.stellar.org

# ------------------------------------------------------------------------------
# Contract IDs (populated after a successful deploy)
# ------------------------------------------------------------------------------
# Leave these blank before the first deploy. After deploying, fill them in and
# also update config/addresses.json with the same values.
# See docs/contract-ids.md for the tracking table format.

MUX_ACCOUNT_CONTRACT_ID=
MUX_BATCHER_CONTRACT_ID=
MUX_DELEGATION_CONTRACT_ID=
MUX_PERMISSIONS_CONTRACT_ID=
MUX_WALLET_REGISTRY_CONTRACT_ID=
MUX_ACCOUNT_FACTORY_CONTRACT_ID=
MUX_REGISTRY_CONTRACT_ID=
MUX_POLICY_CONTRACT_ID=

# ------------------------------------------------------------------------------
# Optional overrides
# ------------------------------------------------------------------------------

# Override the WASM output directory if you use a custom Cargo target dir.
# Default: target/wasm32-unknown-unknown/release
# MUX_WASM_DIR=target/wasm32-unknown-unknown/release

# Set to "true" to run in dry-run mode without submitting any transactions.
# Equivalent to passing --dry-run on the command line.
# MUX_DRY_RUN=false

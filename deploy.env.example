# deploy.env.example
#
# Environment variable template for Mux Protocol contract deployment.
# Copy this file to deploy.env, fill in the values, and source it before
# running scripts/deploy.sh.
#
#   cp deploy.env.example deploy.env
#   # edit deploy.env
#   source deploy.env
#   bash scripts/deploy.sh --network testnet
#
# IMPORTANT: Never commit deploy.env to version control.
# deploy.env is listed in .gitignore to prevent accidental exposure of secrets.

# ── Required for live deployment ───────────────────────────────────────────────

# Stellar secret key (starts with S) used to sign deploy transactions.
DEPLOYER_PRIVATE_KEY=

# Public key (starts with G) set as the contract admin during initialisation.
ADMIN_ADDRESS=

# ── Optional overrides ─────────────────────────────────────────────────────────

# Target Stellar network. Accepted values: testnet | mainnet | localnet
# Defaults to testnet when not set.
# SOROBAN_NETWORK=testnet

# Override the Soroban RPC endpoint for the chosen network.
# Leave unset to use the built-in default for the selected network.
# RPC_URL=https://soroban-testnet.stellar.org

# ── Dry-run / CI usage ─────────────────────────────────────────────────────────
# When running in dry-run mode (--dry-run flag) the above credentials are not
# required and can be left blank.  In CI, pass them as encrypted secrets rather
# than sourcing this file.

{
  "name": "@mux/bindings",
  "version": "0.1.0",
  "description": "Typed bindings for Mux Protocol Soroban contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generated/*": {
      "types": "./dist/generated/*.d.ts",
      "import": "./dist/generated/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:vectors": "vitest run __tests__/test-vectors.test.ts",
    "test:watch": "vitest",
    "lint": "eslint src __tests__",
    "lint:fix": "eslint src __tests__ --fix",
    "local-invoke": "npx ts-node src/local-invoke.ts",
    "generate": "bash ../scripts/generate-bindings.sh",
    "generate:bindings": "npx ts-node ../scripts/generate-bindings.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "soroban",
    "mux",
    "sdk"
  ],
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
